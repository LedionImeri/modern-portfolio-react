# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values you have.
# Every variable is optional — the site works with all of them empty.
# ─────────────────────────────────────────────────────────────

# Public URL of the deployed site, without trailing slash.
# Used for canonical URL, Open Graph / Twitter images, sitemap.xml and robots.txt.
# Example: https://ledionimeri.dev
VITE_SITE_URL=

# Base path if the site is served from a sub-folder (e.g. GitHub Pages project site: /portfolio/)
VITE_BASE_PATH=/

# Google Analytics 4 measurement ID (format: G-XXXXXXXXXX). Leave empty to disable analytics.
VITE_GA_ID=

# Contact form provider: formspree | emailjs | custom
# Leave empty → the form validates and opens the visitor's email app with the message pre-filled.
VITE_CONTACT_PROVIDER=

# Formspree (https://formspree.io) — the form ID from https://formspree.io/f/<ID>
VITE_FORMSPREE_ID=

# EmailJS (https://www.emailjs.com) — template params used: from_name, reply_to, message
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Custom backend — receives POST JSON { name, email, message }
VITE_CONTACT_ENDPOINT=

# Optional LeetCode stats endpoint (see README → "LeetCode statistics").
# Leave empty to use the manual numbers in src/data/config.js.
VITE_LEETCODE_STATS_ENDPOINT=
